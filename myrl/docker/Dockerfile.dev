FROM nvcr.io/nvidia/isaac-lab:2.3.2

# ── 安装 ROS2（自动检测 Ubuntu 版本选择 distro）─────────────────────────
# Noble(24.04)→Jazzy, Jammy(22.04)→Humble。安装失败不阻塞构建（ROS2 非 MVP 必须）
RUN apt-get update && apt-get install -y --no-install-recommends curl gnupg lsb-release \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && CODENAME=$(. /etc/os-release && echo $UBUNTU_CODENAME) \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://packages.ros.org/ros2/ubuntu $CODENAME main" \
        > /etc/apt/sources.list.d/ros2.list \
    && apt-get update \
    && ROS_DISTRO="" \
    && if apt-cache show ros-jazzy-ros-base >/dev/null 2>&1; then ROS_DISTRO=jazzy; \
       elif apt-cache show ros-humble-ros-base >/dev/null 2>&1; then ROS_DISTRO=humble; fi \
    && if [ -n "$ROS_DISTRO" ]; then \
        apt-get install -y --no-install-recommends \
            ros-${ROS_DISTRO}-ros-base \
            ros-${ROS_DISTRO}-std-msgs \
            ros-${ROS_DISTRO}-sensor-msgs \
            ros-${ROS_DISTRO}-geometry-msgs \
            ros-${ROS_DISTRO}-nav-msgs \
            python3-colcon-common-extensions; \
        echo "ROS2_DISTRO=$ROS_DISTRO" > /opt/.ros2_distro; \
       else echo "[WARN] No ROS2 distro available for $CODENAME, skipping"; fi \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/myrl
COPY entrypoint.sh /opt/myrl/entrypoint.sh
COPY requirements-dev.txt /opt/myrl/requirements-dev.txt
RUN chmod +x /opt/myrl/entrypoint.sh

ENTRYPOINT ["/opt/myrl/entrypoint.sh"]
CMD ["bash"]
